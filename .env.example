NEXT_PUBLIC_NEIGHBORHOOD_NAME=שיכון ותיקים · חרוזים · נחלת גנים
NEXT_PUBLIC_MAP_CENTER_LAT=32.0919
NEXT_PUBLIC_MAP_CENTER_LNG=34.8112
# On Vercel: add a Blob store and set this so approvals survive refreshes
# BLOB_READ_WRITE_TOKEN=
# Optional free Cloudinary unsigned preset — keeps house photos longer than 72h
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Optional free Carto key if you want the original dark Carto tiles
# (without it the map uses OpenStreetMap + a local dark filter)
# NEXT_PUBLIC_CARTO_API_KEY=
# Web Push (optional). If missing, keys are generated on first boot and stored with the house data.
# On Vercel, set these so subscriptions survive a fresh disk:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
