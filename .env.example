ADMIN_PASSWORD=pumpkin2026
# Vercel Preview: add ADMIN_PASSWORD (or PREVIEW_ADMIN_PASSWORD) under Preview env if you want a non-default secret.
# If unset on preview only, login uses pumpkin2026 — not used on Production without ADMIN_PASSWORD.
# PREVIEW_ADMIN_PASSWORD=
NEXT_PUBLIC_NEIGHBORHOOD_NAME=שיכון ותיקים · חרוזים · נחלת גנים · הגפן
NEXT_PUBLIC_MAP_CENTER_LAT=32.0919
NEXT_PUBLIC_MAP_CENTER_LNG=34.8112
# Public site URL (CARTO Referer probe + links). Production: https://my-hollaween-app.vercel.app
# NEXT_PUBLIC_APP_URL=
# CARTO basemap key — Voyager basemap (free ~5M tiles/month; dashboard shows usage).
# Restrict Referer to your public host(s), e.g. my-hollaween-app.vercel.app — not each deploy URL.
# Set NEXT_PUBLIC_APP_URL=https://my-hollaween-app.vercel.app so server health checks use the same host.
# No key → /api/map-config falls back to OpenStreetMap France tiles.
# Get a key: https://carto.com/basemaps/apikey
# Vercel → Settings → Environment Variables:
#   Name: CARTO_BASEMAP_KEY   Type: Secret   Environments: Production (+ Preview)
# No redeploy needed for runtime secret, but redeploy once after first add. Check /api/map-config → keyActive:true
# CARTO_BASEMAP_KEY=
# Default CARTO basemap hides street/building numbers (voyager_nolabels). Set to 1 to show labels:
# NEXT_PUBLIC_MAP_STREET_LABELS=1
# Primary durable storage (recommended for production): Firebase Firestore
# Option A — paste the full service account JSON (Vercel: one env var):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option B — split fields (private key newlines as \n):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIRESTORE_NEIGHBORHOOD_ID=default
# If create-database used id "default" instead of "(default)":
# FIRESTORE_DATABASE_ID=default
# Foreground catalog poll interval (seconds). Set in Vercel → Production, then redeploy.
# Phones learn the value from /api/catalog (pollSeconds + X-Catalog-Poll-Seconds header).
# Floor: 30s. Overnight (22:00–08:00 UTC on server): at least 600s. After empty polls: stretches up to 15m.
# CATALOG_POLL_SECONDS=180
# One-time import: node scripts/migrate-to-firestore.mjs
#
# House photos (permanent hosting — recommended):
# BLOB_READ_WRITE_TOKEN=   # auto-created when a Blob store is connected to the project
# BLOB_STORE_ID=           # optional; also derived from the token
# On Vercel Hobby, Blob Simple Operations reset monthly — once set, photo uploads use
# Blob first with no redeploy needed when quota returns.
# Optional free Cloudinary unsigned preset — extra photo hosting if Blob is unset
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Catbox permanent fallback — anonymous uploads are blocked; create a free account at catbox.moe
# and paste your userhash from Account → API access:
# CATBOX_USERHASH=
# Help contact form (menu → עזרה אישית): stores in Firestore when Firebase is set,
# or in DATA_DIR/help-requests.json locally. Instant free notifications:
# Discord or Slack incoming webhook URL (also works with Telegram/n8n — JSON body).
# HELP_REQUEST_WEBHOOK_URL=
#
# Neighborhood push alerts (bell icon, admin alerts, owner offers). Default off.
# Set to 1 in Vercel to enable; redeploy required (NEXT_PUBLIC_*).
# NEXT_PUBLIC_PUSH_ALERTS=1
# Web Push (optional). If missing, keys are generated on first boot and stored with the house data.
# On Vercel, set these so subscriptions survive a fresh disk:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
