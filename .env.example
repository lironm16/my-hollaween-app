ADMIN_PASSWORD=pumpkin2026
NEXT_PUBLIC_NEIGHBORHOOD_NAME=שיכון ותיקים · חרוזים · נחלת גנים
NEXT_PUBLIC_MAP_CENTER_LAT=32.0919
NEXT_PUBLIC_MAP_CENTER_LNG=34.8112
# On Vercel: connect a Blob store (sets BLOB_READ_WRITE_TOKEN + BLOB_STORE_ID).
# Do not paste tokens manually unless needed — the SDK uses OIDC on Vercel when token is omitted.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# Optional free Cloudinary unsigned preset — extra photo hosting if Blob is unset
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Web Push (optional). If missing, keys are generated on first boot and stored with the house data.
# On Vercel, set these so subscriptions survive a fresh disk:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
