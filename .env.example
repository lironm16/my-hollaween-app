NEXT_PUBLIC_MAP_CENTER_LAT=32.0919
NEXT_PUBLIC_MAP_CENTER_LNG=34.8112
# CARTO basemap key — removes tile watermarks (free: 5M tiles/month).
# Get one at https://carto.com/basemaps/apikey — restrict Referer to my-hollaween-app.vercel.app
# Vercel → Settings → Environment Variables:
#   Name: CARTO_BASEMAP_KEY   Type: Secret   Environments: Production (+ Preview)
# No redeploy needed for runtime secret, but redeploy once after first add. Check /api/map-config → keyActive:true
# CARTO_BASEMAP_KEY=
# Primary durable storage (recommended for production): Firebase Firestore
# Option A — paste the full service account JSON (Vercel: one env var):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option B — split fields (private key newlines as \n):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIRESTORE_NEIGHBORHOOD_ID=default
# If create-database used id "default" instead of "(default)":
# FIRESTORE_DATABASE_ID=default
# Foreground catalog poll interval (seconds). Phones pick this up from /api/catalog without redeploy.
# CATALOG_POLL_SECONDS=300
# One-time import: node scripts/migrate-to-firestore.mjs
#
# House photos (permanent hosting — recommended):
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# Optional free Cloudinary unsigned preset — extra photo hosting if Blob is unset
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Catbox permanent fallback — anonymous uploads are blocked; create a free account at catbox.moe
# and paste your userhash from Account → API access:
# CATBOX_USERHASH=
# Neighborhood push alerts (bell icon, admin alerts, owner offers). Default off.
# Set to 1 in Vercel to enable; redeploy required (NEXT_PUBLIC_*).
# NEXT_PUBLIC_PUSH_ALERTS=1
# Web Push (optional). If missing, keys are generated on first boot and stored with the house data.
# On Vercel, set these so subscriptions survive a fresh disk:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
