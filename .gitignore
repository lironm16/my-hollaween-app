# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# runtime house database (seed.json is committed)
/data/db.json
/data/traffic.json
/data/devices.json
/data/.write-probe
/data/cute-monsters/
/data/cute-monsters.zip
/data/__MACOSX/

# Large itch zips — unzip into Projects/akochan-halloween-pets/ instead
/Projects/**/*.zip
/Projects/**/LowPoly*.zip

# optional house photos (generated locally)
/public/house-photos/*.jpg
/public/house-photos/*.jpeg
/public/house-photos/*.webp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

AGENTS.md
CLAUDE.md
scripts/__pycache__/
