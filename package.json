{
  "name": "halloween-neighborhood",
  "version": "0.1.98",
  "private": true,
  "scripts": {
    "dev": "node scripts/allow-preview-origin.mjs && node scripts/build-css.mjs && next dev --webpack --hostname 0.0.0.0 --port 43127",
    "postinstall": "node scripts/allow-preview-origin.mjs && node scripts/ensure-git-author.mjs",
    "build": "node scripts/build-css.mjs && node scripts/sync-sw-version.mjs && node scripts/build-catalog.mjs && node scripts/render-gem-monster-posters.mjs && next build",
    "start": "next start --hostname 0.0.0.0 --port 43127",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "tsx --test 'src/**/*.test.ts'",
    "test:stress": "node scripts/run-stress.mjs",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:all": "npm run test:unit && npm run test:api && npm run test:stress && npm run test:e2e",
    "ci": "node scripts/ci.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "stub-images": "node scripts/generate-stub-images.mjs",
    "poi-pin-icons": "python3 scripts/extract-badge-glyphs.py",
    "app-icons": "node scripts/generate-app-icons.mjs",
    "gem-monster-posters": "node scripts/render-gem-monster-posters.mjs",
    "stress": "node scripts/stress-test.mjs",
    "migrate:firestore": "node scripts/migrate-to-firestore.mjs",
    "seed:catalog-meta": "node scripts/seed-catalog-meta.mjs",
    "seed:catalog-snapshot": "node --import tsx scripts/seed-catalog-snapshot.mjs",
    "purge:firestore-stubs": "node scripts/purge-firestore-stubs.mjs",
    "purge:e2e-houses": "node scripts/purge-e2e-test-houses.mjs",
    "sync:github": "node scripts/sync-github.mjs",
    "capture:help": "node scripts/capture-help-screenshots.mjs",
    "deploy:vercel": "node scripts/trigger-vercel.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase-admin": "^13.10.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.39.0",
    "marked": "^18.0.13",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.55.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
